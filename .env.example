# olivetin-mcp configuration
# Copy to .env and adjust for your environment.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Port the MCP SSE server listens on.
HOST_BRIDGE_PORT=9003

# URL of your OliveTin instance. Use http://host.docker.internal:1337 for
# Docker Desktop, or http://olivetin:1337 in Docker Compose.
OLIVETIN_URL=http://host.docker.internal:1337

# ── OPTIONAL: Approval UI ────────────────────────────────────────────────────
# Public URL for approval links. If unset, defaults to http://localhost:9003.
# Set this to the externally reachable address (e.g. https://bridge.example.com).
APPROVAL_BASE_URL=

# Seconds to wait for a human to approve/deny via URL before timing out.
APPROVAL_TIMEOUT_SECS=120

# Seconds to wait for the MCP client to respond to an inline elicitation dialog
# before falling back to URL-based approval.
ELICITATION_TIMEOUT_SECS=30

# ── OPTIONAL: Secrets ────────────────────────────────────────────────────────
# Directory for Docker secrets (e.g. brave_api_key, olivetin_jwt_token).
SECRETS_DIR=/run/secrets

# ── OPTIONAL: Action catalog ─────────────────────────────────────────────────
# How often (seconds) to refresh the action list from OliveTin.
ACTION_REFRESH_INTERVAL_SECS=300

# ── OPTIONAL: Authentication (pick ONE mode) ─────────────────────────────────
# All fields are optional. Set the ones that match your OliveTin auth setup.
# If none are set, requests are sent without authentication.

# Mode 1: Reverse-proxy header auth (e.g. Authelia, Authentik, nginx)
OLIVETIN_REMOTE_USER=
OLIVETIN_REMOTE_GROUPS=
OLIVETIN_USER_HEADER=X-Remote-User
OLIVETIN_GROUPS_HEADER=X-Remote-Groups

# Mode 2: JWT bearer token (or mount as /run/secrets/olivetin_jwt_token)
OLIVETIN_JWT_TOKEN=

# Mode 3: HTTP Basic auth
OLIVETIN_BASIC_USER=
OLIVETIN_BASIC_PASS=
